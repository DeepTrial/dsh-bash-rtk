{
  "name": "@deeptrial/dsh-bash-rtk",
  "description": "DeepSeek Harness bash executor plugin that routes eligible commands through rtk (Rust Token Killer) to compress tool output and save tokens. Optional overlay: install, then enable via --patch.",
  "version": "0.1.1",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./wrap": {
      "types": "./lib/wrap.d.ts",
      "default": "./lib/wrap.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-bash-local": "0.0.1-rc.1",
    "@deepseek-ai/dsh-bash-sandbox": "0.0.1-rc.1",
    "@deepseek-ai/dsh-shell": "0.0.1-rc.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-bash-local": { "optional": true },
    "@deepseek-ai/dsh-bash-sandbox": { "optional": true },
    "@deepseek-ai/dsh-shell": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-bash-local": "link:../deepseek-harness/packages/shell/bash-local",
    "@deepseek-ai/dsh-bash-sandbox": "link:../deepseek-harness/packages/shell/bash-sandbox",
    "@deepseek-ai/dsh-shell": "link:../deepseek-harness/packages/shell/shell",
    "@deepseek-ai/dsh-subprocess-local": "link:../deepseek-harness/packages/subprocess/subprocess-local",
    "@deepseek-ai/dsh-sandbox": "link:../deepseek-harness/packages/sandbox/sandbox",
    "@deepseek-ai/dsh-sandbox-local": "link:../deepseek-harness/packages/sandbox/sandbox-local",
    "@deepseek-ai/dsh-sandbox-policy": "link:../deepseek-harness/packages/sandbox/sandbox-policy",
    "cordis": "link:../deepseek-harness/vendor/cordis",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.2",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "rtk",
    "token-compression",
    "bash",
    "shell",
    "cordis",
    "plugin"
  ],
  "homepage": "https://github.com/DeepTrial/dsh-bash-rtk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepTrial/dsh-bash-rtk.git"
  },
  "bugs": {
    "url": "https://github.com/DeepTrial/dsh-bash-rtk/issues"
  },
  "author": "DeepTrial",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
