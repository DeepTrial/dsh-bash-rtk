{
  "name": "@deeptrial/dsh-bash-rtk",
  "description": "DeepSeek Harness bash executor plugin that routes eligible commands through rtk (Rust Token Killer) to compress tool output and save tokens. Optional overlay: install, then enable via --patch.",
  "version": "0.1.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./wrap": {
      "types": "./lib/wrap.d.ts",
      "default": "./lib/wrap.js"
    },
    "./command": {
      "types": "./lib/command.d.ts",
      "default": "./lib/command.js"
    },
    "./stats": {
      "types": "./lib/stats.d.ts",
      "default": "./lib/stats.js"
    },
    "./client": "./client/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "dsh.plugin.json"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-bash-local": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.1.1 || >=0.1.1-rc.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-bash-sandbox": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.1.1 || >=0.1.1-rc.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0",
    "@deepseek-ai/dsh-shell": ">=0.0.1-rc.1 <0.1.0 || >=0.1.0-rc.1 <0.1.1 || >=0.1.1-rc.1 <0.2.0-0 || >=0.2.0-0 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-bash-local": { "optional": true },
    "@deepseek-ai/dsh-bash-sandbox": { "optional": true },
    "@deepseek-ai/dsh-shell": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5-alpha.1",
    "@deepseek-ai/dsh-bash-local": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-bash-sandbox": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-sandbox": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session-projection": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-shell": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.1-alpha.1",
    "@deepseek-ai/schemastery": "~3.18.5-alpha.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "tsdown": "^0.22.2",
    "vitest": "^4.1.0"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "rtk",
    "token-compression",
    "bash",
    "shell",
    "cordis",
    "plugin"
  ],
  "homepage": "https://github.com/DeepTrial/dsh-bash-rtk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepTrial/dsh-bash-rtk.git"
  },
  "bugs": {
    "url": "https://github.com/DeepTrial/dsh-bash-rtk/issues"
  },
  "author": "DeepTrial",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.1.0-rc.6 <0.2.0 || >=0.2.0-0 <0.3.0-0"
  }
}
